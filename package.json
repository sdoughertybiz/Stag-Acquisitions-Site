{
  "name": "stag-acquisitions-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Dougherty Acquisitions — marketing site with Follow Up Boss lead capture, deployed on Cloudflare Workers.",
  "scripts": {
