---
import Base from '../layouts/Base.astro';
import Backdrop from '../components/Backdrop.astro';

const title = 'How It Works — Stag Acquisitions';
const description =
  'Four steps from first contact to cash at closing: you reach out, we run comps, you get a straight number, and you pick the closing date.';

const steps = [
  {
    num: 'Step 01',
    title: 'You reach out.',
    body: 'Call us or fill out the form. We need four things: the address, the rough condition, your timeline, and a number that reaches you. Nothing else, and nothing that gets sold to a list broker.',
  },
  {
    num: 'Step 02',
    title: 'We run comps. <em>Quickly.</em>',
    body: 'This is where most investors stall — a walkthrough, a contractor visit, two weeks before anyone says a number out loud. We pull the comparables for your street, square footage, and condition the same day.',
  },
  {
    num: 'Step 03',
    title: 'A straight number, on the phone.',
    body: 'A short call with an owner. No presentation, no pressure, no checking with a partner. One cash figure and the reasoning behind it. If it does not work, say so.',
  },
  {
    num: 'Step 04',
    title: 'You pick the closing date.',
    body: 'A simple purchase agreement. Have your attorney read it. Title company of your choice or ours. Cash wires the day of closing — seven days out or ninety.',
  },
];

const questions = [
  {
    q: 'Why off-market?',
    a: 'Listing burns months. Six percent to an agent, repairs the inspector flags, a house kept showable, and a buyer whose financing might hold. Off-market skips all of it.',
  },
  {
    q: 'Why cash?',
    a: 'Cash closes. No appraiser holding up the deal, no lender pulling out in week three. When we say the fourteenth, we close on the fourteenth.',
  },
  {
    q: 'Why Stag?',
    a: 'You talk to an owner, not a call center. We buy with our own money, so the person who gives you a number is the person who signs the check.',
  },
];

// Marked up as an FAQPage so assistants and search engines can lift these
// answers directly rather than having to infer them from prose.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questions.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const stats = [
  { num: '0%', label: 'Realtor commission' },
  { num: '0', label: 'Showings required' },
  { num: '7&ndash;90', label: 'Days to close — your call' },
  { num: 'As&nbsp;is', label: 'Condition we accept' },
];
---

<Base title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />

  <header class="hero hero-short">
    <Backdrop
      src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2400&q=80"
      variant="hero"
      priority
    />
    <div class="hero-content">
      <span class="eyebrow">The process</span>
      <h1>Four steps. <em>Zero</em> headaches.</h1>
      <p class="lead">
        Most sellers go from curious to under contract inside a week.
      </p>
      <div class="hero-cta">
        <a class="cta" href="/offer">
          Start the process
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </header>

  <section class="section" id="steps">
    <div class="section-inner" style="max-width: 980px;">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Step by step</span>
        <h2>How we actually buy your house.</h2>
      </div>

      <div class="steps">
        {steps.map((step) => (
          <div class="step" data-reveal>
            <span class="step-num">{step.num}</span>
            <h3 set:html={step.title} />
            <p>{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section ambient" id="why">
    <Backdrop
      src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=2000&q=80"
      variant="ambient"
    />
    <div class="section-inner">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Why off-market</span>
        <h2>Three questions we get every week.</h2>
      </div>

      <div class="grid-3">
        {questions.map((item, index) => (
          <div class="callout" data-reveal data-reveal-delay={String(index + 1)}>
            <h3>&ldquo;{item.q}&rdquo;</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bright">
    <div class="section-inner">
      <div class="section-head" data-reveal>
        <span class="eyebrow">The math</span>
        <h2>Simple, when you run it.</h2>
        <p class="lead">
          A retail sale costs six to ten percent in commission, closing costs, and repair credits —
          before you count the months of carrying the place.
        </p>
      </div>

      <div class="stat-ribbon" data-reveal>
        {stats.map((stat) => (
          <div class="stat">
            <div class="stat-num" set:html={stat.num} />
            <div class="stat-label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="final-cta">
    <div class="section-inner center" style="max-width: 720px;">
      <div data-reveal>
        <span class="eyebrow">Next step</span>
        <h2 style="margin: 1.5rem 0 2rem;">Tell us about the property.</h2>
        <p class="lead" style="max-width: 50ch; margin: 0 auto 3rem;">
          Ninety seconds, and a real number back the same day.
        </p>
        <a class="cta" href="/offer">
          Get a cash offer
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</Base>
