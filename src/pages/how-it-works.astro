---
import Base from '../layouts/Base.astro';
import Backdrop from '../components/Backdrop.astro';

const title = 'How It Works — Stag Acquisitions';
const description =
  'How a specialized acquisition comes together: a buy-side client defines their criteria, we source off-market properties that match, we agree terms with the owner, and the buyer closes.';

const steps = [
  {
    num: 'Step 01',
    title: 'A client defines the box.',
    body: 'A developer or investor tells us exactly what they are buying — asset type, markets, price band, the scope of work they will take on, and how fast they can close. That becomes the brief we work against.',
  },
  {
    num: 'Step 02',
    title: 'We work the market. <em>Directly.</em>',
    body: 'This is the part nobody has time for: outreach to owners, conversations that go nowhere, and the follow-up months later that finally lands. We do it continuously, in the markets we know, off-market.',
  },
  {
    num: 'Step 03',
    title: 'We agree terms with the owner.',
    body: 'When a property fits, we work through price and timing with the owner directly and put it in writing. One number and a closing date — not a range, and not a maybe.',
  },
  {
    num: 'Step 04',
    title: 'The buyer closes.',
    body: 'The property goes to the developer or investor whose criteria it matched. Title company of your choice or ours, and the closing date the owner picked.',
  },
];

const questions = [
  {
    q: 'Who actually buys the property?',
    a: 'One of the developers or investors we work with. We are the acquisitions arm — we find the property, work out terms with the owner, and hand it to the buyer whose criteria it matched. We are not a brokerage and we do not list properties.',
  },
  {
    q: 'What does it cost a seller?',
    a: 'Nothing out of pocket, and no agent commission. There is no listing, no staging, no repairs, and no showings. You deal with us directly and you know the number before anything is signed.',
  },
  {
    q: 'Why not just list it?',
    a: 'A listing costs months and six to ten percent in commission, closing costs, and repair credits — plus a buyer whose financing might not hold. Off-market skips all of it when speed and certainty matter more than squeezing the last dollar.',
  },
];

// Marked up as an FAQPage so assistants and search engines can lift these
// answers directly rather than having to infer them from prose.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questions.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const stats = [
  { num: '0%', label: 'Seller commission' },
  { num: '0', label: 'Showings required' },
  { num: '7&ndash;90', label: 'Days to close — seller picks' },
  { num: 'As&nbsp;is', label: 'Condition accepted' },
];
---

<Base title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />

  <header class="hero hero-short">
    <Backdrop
      src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2400&q=80"
      variant="hero"
      priority
    />
    <div class="hero-content">
      <span class="eyebrow">The process</span>
      <h1>Four steps. <em>Both</em> sides covered.</h1>
      <p class="lead">
        One side knows what it wants to buy. The other wants out without a listing. Our job is the
        distance between them.
      </p>
      <div class="hero-cta">
        <a class="cta" href="/offer">
          I am selling
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a class="cta-ghost" href="/investors">I am buying</a>
      </div>
    </div>
  </header>

  <section class="section" id="steps">
    <div class="section-inner" style="max-width: 980px;">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Step by step</span>
        <h2>How a deal actually comes together.</h2>
      </div>

      <div class="steps">
        {steps.map((step) => (
          <div class="step" data-reveal>
            <span class="step-num">{step.num}</span>
            <h3 set:html={step.title} />
            <p>{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section ambient" id="why">
    <Backdrop
      src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=2000&q=80"
      variant="ambient"
    />
    <div class="section-inner">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Straight answers</span>
        <h2>Three questions we get every week.</h2>
      </div>

      <div class="grid-3">
        {questions.map((item, index) => (
          <div class="callout" data-reveal data-reveal-delay={String(index + 1)}>
            <h3>&ldquo;{item.q}&rdquo;</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bright">
    <div class="section-inner">
      <div class="section-head" data-reveal>
        <span class="eyebrow">The math</span>
        <h2>Simple, when you run it.</h2>
        <p class="lead">
          A retail sale costs six to ten percent in commission, closing costs, and repair credits —
          before you count the months of carrying the place.
        </p>
      </div>

      <div class="stat-ribbon" data-reveal>
        {stats.map((stat) => (
          <div class="stat">
            <div class="stat-num" set:html={stat.num} />
            <div class="stat-label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="final-cta">
    <div class="section-inner center" style="max-width: 720px;">
      <div data-reveal>
        <span class="eyebrow">Next step</span>
        <h2 style="margin: 1.5rem 0 2rem;">Start where you stand.</h2>
        <p class="lead" style="max-width: 50ch; margin: 0 auto 3rem;">
          Ninety seconds either way, and a real conversation back the same day.
        </p>
        <div class="hero-cta" style="justify-content: center;">
          <a class="cta" href="/offer">
            Submit a property
            <span class="arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="cta-ghost" href="/investors#buy-box">Send us your buy box</a>
        </div>
      </div>
    </div>
  </section>
</Base>
