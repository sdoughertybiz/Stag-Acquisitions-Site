---
import Base from '../layouts/Base.astro';
import Backdrop from '../components/Backdrop.astro';

const title = 'Stag Acquisitions — Family-Owned Cash Home Buyers';

const values = [
  {
    title: 'No realtor fees',
    body: 'Zero commission. The number we give is the number you net.',
  },
  {
    title: 'No showings',
    body: 'No staging, no open houses, no buyer who walks in week three.',
  },
  {
    title: 'Close on your timeline',
    body: "Seven days if you need it. Ninety if you don't. Your call.",
  },
  {
    title: 'Any condition',
    body: "Code violations, tenants in place, deferred everything. We've bought it all.",
  },
];

const steps = [
  {
    num: '01',
    title: 'You reach out',
    body: 'Address, condition, timeline. Two minutes.',
  },
  {
    num: '02',
    title: 'We run comps',
    body: 'Same day, usually. The first number you hear is the real one.',
  },
  {
    num: '03',
    title: 'Straight number',
    body: 'A short call with an owner. Not a range. A number.',
  },
  {
    num: '04',
    title: 'Pick your date',
    body: 'Seven days or ninety. Cash wires the day of closing.',
  },
];

const situations = [
  {
    title: 'Tired landlord',
    body: 'Maintenance calls at 2am and rent that stopped feeling worth it. Sell quietly, tenant in place.',
  },
  {
    title: 'Inherited property',
    body: 'Probate cleared, the house is three states away, and nobody wants the repairs. Sell it as-is.',
  },
  {
    title: 'Pre-foreclosure',
    body: 'The bank is moving. We close fast and clean so you walk away with something.',
  },
  {
    title: 'Major repairs',
    body: "Roof, foundation, water damage, open permits. Skip the fixes — we'll take it.",
  },
  {
    title: 'Divorce or life change',
    body: 'Quick and quiet, without a sign in the yard. A cash close is built for this.',
  },
  {
    title: 'Just ready to move on',
    body: 'A house that no longer fits. Cash next week beats a maybe in six months.',
  },
];
---

<Base title={title}>
  <header class="hero">
    <Backdrop
      src="https://images.unsplash.com/photo-1613977257363-707ba9348227?auto=format&fit=crop&w=2400&q=80"
      variant="hero"
      priority
    />

    <div class="hero-content">
      <span class="eyebrow">Family-owned</span>
      <h1>Sell your home <em>off&#8209;market.</em></h1>
      <p class="hero-tagline">Fast &middot; Simple &middot; Hassle-free</p>
      <div class="hero-cta">
        <a class="cta" href="/offer">
          Get your offer now
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a class="cta-ghost" href="/how-it-works">See how it works</a>
      </div>
    </div>

    <div class="scroll-indicator" aria-hidden="true">Scroll</div>
  </header>

  <section class="section" id="who">
    <div class="section-inner">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Who we are</span>
        <h2>Private buyers.<br />Not agents. Not a marketplace.</h2>
        <p class="lead">
          Stag Acquisitions is a family-owned investment group buying with its own capital in
          Nashville, Scottsdale, Charlotte, and across the country. No call center, no lead broker
          reselling your address. You talk to an owner and you get a real number.
        </p>
      </div>

      <div class="grid-4">
        {values.map((value, index) => (
          <div class="feature-compact" data-reveal data-reveal-delay={String(index + 1)}>
            <h4>{value.title}</h4>
            <p>{value.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section ambient" id="process">
    <Backdrop
      src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=2000&q=80"
      variant="ambient"
    />
    <div class="section-inner">
      <div class="section-head" data-reveal>
        <span class="eyebrow">The process</span>
        <h2>Four steps. Zero headaches.</h2>
        <p class="lead">
          Most sellers go from curious to under contract inside a week.
        </p>
      </div>

      <div class="grid-4">
        {steps.map((step, index) => (
          <div class="feature" data-reveal data-reveal-delay={String(index + 1)}>
            <span class="feature-num">{step.num}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        ))}
      </div>

      <div class="center" style="margin-top: 5rem;" data-reveal>
        <a class="cta-ghost" href="/how-it-works">
          Full process breakdown
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section bright" id="situations">
    <div class="section-inner">
      <div class="section-head" data-reveal>
        <span class="eyebrow">What we buy</span>
        <h2>Real situations. Real solutions.</h2>
        <p class="lead">
          We do not need to know why you are selling. Here is what comes through every week.
        </p>
      </div>

      <div class="grid-3">
        {situations.map((item, index) => (
          <div class="feature" data-reveal data-reveal-delay={String((index % 3) + 1)}>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section ambient" id="final-cta">
    <Backdrop
      src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2000&q=80"
      variant="ambient"
    />
    <div class="section-inner center" style="max-width: 780px;">
      <div data-reveal>
        <span class="eyebrow">Ready</span>
        <h2 style="margin: 1.5rem 0 2rem;">Let's see a number together.</h2>
        <p class="lead" style="max-width: 52ch; margin: 0 auto 3rem;">
          No obligation and no pitch. Ninety seconds of your time — and if the number works, we
          close.
        </p>
        <a class="cta" href="/offer">
          Get a cash offer
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</Base>
