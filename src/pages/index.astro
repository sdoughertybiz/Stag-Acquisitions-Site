---
import Base from '../layouts/Base.astro';
import Backdrop from '../components/Backdrop.astro';
import Testimonials from '../components/Testimonials.astro';
import { paths, scripture } from '../data/site';

const title = 'Sell Your Property Without Listing It — Stag Acquisitions';

// What the buy-side client actually gets. This is the service being sold.
const service = [
  {
    title: 'You set the box',
    body: 'Asset type, markets, price band, scope you will take on. One conversation, then we go.',
  },
  {
    title: 'We work the market',
    body: 'Off-market outreach, owner conversations, and the follow-up nobody has time for.',
  },
  {
    title: 'We filter hard',
    body: 'You see the properties that fit. Not a feed, not a list — a short list worth your time.',
  },
  {
    title: 'You stay on your projects',
    body: 'Sourcing stops competing with the work you are already carrying.',
  },
];

const steps = [
  {
    num: '01',
    title: 'A client sets the criteria',
    body: 'A developer or investor tells us exactly what they are buying and where.',
  },
  {
    num: '02',
    title: 'We go find it',
    body: 'Off-market outreach in the markets we work. Direct to owners.',
  },
  {
    num: '03',
    title: 'We agree on terms',
    body: 'A firm number and a closing date, put in writing with the owner.',
  },
  {
    num: '04',
    title: 'The buyer closes',
    body: 'The developer or investor we matched it to takes it to the table.',
  },
];

const situations = [
  {
    title: 'Tired landlord',
    body: 'Maintenance calls at 2am and rent that stopped feeling worth it. Sell quietly, tenant in place.',
  },
  {
    title: 'Inherited property',
    body: 'Probate cleared, the house is three states away, and nobody wants the repairs. Sell it as-is.',
  },
  {
    title: 'Pre-foreclosure',
    body: 'The bank is moving. We move fast and clean so you walk away with something.',
  },
  {
    title: 'Major repairs',
    body: 'Roof, foundation, water damage, open permits. Skip the fixes — our buyers want the project.',
  },
  {
    title: 'Divorce or life change',
    body: 'Quick and quiet, without a sign in the yard. A cash close is built for this.',
  },
  {
    title: 'Just ready to move on',
    body: 'A house that no longer fits. A real number next week beats a maybe in six months.',
  },
];
---

<Base title={title}>
  <header class="hero">
    <Backdrop
      src="https://images.unsplash.com/photo-1613977257363-707ba9348227?auto=format&fit=crop&w=2400&q=80"
      variant="hero"
      priority
    />

    <div class="hero-content">
      <span class="eyebrow">Off-market property sales</span>
      <h1>Sell it without <em>listing it.</em></h1>
      <p class="hero-tagline">No commission &middot; No showings &middot; No repairs</p>
      <div class="hero-cta">
        <a class="cta" href="/offer">
          Get a number on your property
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a class="cta-ghost" href="/investors">I am a developer or investor</a>
      </div>
    </div>

    <div class="scroll-indicator" aria-hidden="true">Scroll</div>
  </header>

  <section class="section" id="what-we-do">
    <div class="section-inner">
      <div class="section-head" data-reveal>
        <span class="eyebrow">What we do</span>
        <h2>We already know<br />who is buying.</h2>
        <p class="lead">
          Stag Acquisitions is a family-owned specialized acquisitions firm. Developers and
          investors tell us exactly what they are looking for, and we work our markets to find it.
          If your property fits what they are buying, you get a straight number without ever
          putting it on the market.
        </p>
      </div>

      <div class="path-grid">
        {paths.map((path, index) => (
          <a class="path-card" href={path.href} data-reveal data-reveal-delay={String(index + 1)}>
            <span class="eyebrow">{path.eyebrow}</span>
            <h3>{path.title}</h3>
            <p>{path.body}</p>
            <span class="path-cta">
              {path.cta}
              <span class="arrow" aria-hidden="true">&rarr;</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section bright" id="situations">
    <div class="section-inner">
      <div class="section-head" data-reveal>
        <span class="eyebrow">For sellers</span>
        <h2>Real situations. Real buyers.</h2>
        <p class="lead">
          We do not need to know why you are selling. Here is what comes through every week — and
          in most of it, we already know who is looking.
        </p>
      </div>

      <div class="grid-3">
        {situations.map((item, index) => (
          <div class="feature" data-reveal data-reveal-delay={String((index % 3) + 1)}>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>

      <div class="center" style="margin-top: 5rem;" data-reveal>
        <a class="cta-ghost" href="/offer">
          Submit your property
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <Testimonials
    variant="plain"
    eyebrow="Track record"
    heading="People we have done this for."
    max={6}
  />

  <section class="section ambient" id="process">
    <Backdrop
      src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=2000&q=80"
      variant="ambient"
    />
    <div class="section-inner">
      <div class="section-head" data-reveal>
        <span class="eyebrow">The process</span>
        <h2>How a deal actually comes together.</h2>
        <p class="lead">
          Four steps, and both sides know where they stand at every one of them.
        </p>
      </div>

      <div class="grid-4">
        {steps.map((step, index) => (
          <div class="feature" data-reveal data-reveal-delay={String(index + 1)}>
            <span class="feature-num">{step.num}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        ))}
      </div>

      <div class="center" style="margin-top: 5rem;" data-reveal>
        <a class="cta-ghost" href="/how-it-works">
          Full process breakdown
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="service">
    <div class="section-inner">
      <div class="section-head" data-reveal>
        <span class="eyebrow">For the buy side</span>
        <h2>Acquisitions is a full-time job.<br />It does not have to be yours.</h2>
        <p class="lead">
          Most developers and investors lose deals to bandwidth, not capital. We run the sourcing
          function so your team can stay on the projects already under way.
        </p>
      </div>

      <div class="grid-4">
        {service.map((item, index) => (
          <div class="feature-compact" data-reveal data-reveal-delay={String(index + 1)}>
            <h4>{item.title}</h4>
            <p>{item.body}</p>
          </div>
        ))}
      </div>

      <div class="center" style="margin-top: 5rem;" data-reveal>
        <a class="cta" href="/investors">
          Tell us what you are looking for
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section bright" id="values">
    <div class="section-inner">
      <div class="grid-2" style="gap: 5rem; align-items: start;">
        <div data-reveal>
          <span class="eyebrow">What drives this</span>
          <h2 style="margin: 1.4rem 0 2rem;">A family business<br />built on faith.</h2>
          <blockquote class="verse">
            <p>{scripture.text}</p>
            <cite>{scripture.reference} <span>({scripture.translation})</span></cite>
          </blockquote>
        </div>

        <div data-reveal data-reveal-delay="2">
          <p class="lead" style="margin-bottom: 1.6rem;">
            Most people find us at a hard moment. How we handle that is the whole business — honest
            numbers, straight answers, and no pressure to decide today.
          </p>
          <p style="margin-bottom: 1.6rem;">
            Our Christian faith is the reason we work this way, and it is why we would rather state
            plainly where we stand in a deal than leave you to assume it.
          </p>
          <a class="cta-ghost" href="/values">
            What we stand for
            <span class="arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section ambient" id="final-cta">
    <Backdrop
      src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2000&q=80"
      variant="ambient"
    />
    <div class="section-inner center" style="max-width: 780px;">
      <div data-reveal>
        <span class="eyebrow">Ready</span>
        <h2 style="margin: 1.5rem 0 2rem;">Send us the address.</h2>
        <p class="lead" style="max-width: 52ch; margin: 0 auto 3rem;">
          Ninety seconds, no obligation, and a straight answer the same day on whether it fits
          what our buyers are looking for.
        </p>
        <div class="hero-cta" style="justify-content: center;">
          <a class="cta" href="/offer">
            Get a number on your property
            <span class="arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="cta-ghost" href="/investors">I am buying, not selling</a>
        </div>
      </div>
    </div>
  </section>
</Base>
