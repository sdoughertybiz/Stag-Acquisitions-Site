---
import Base from '../layouts/Base.astro';
import Backdrop from '../components/Backdrop.astro';
import SellerForm from '../components/SellerForm.astro';
import { site } from '../data/site';

const title = 'Sell A Property — Stag Acquisitions';
const description =
  'Tell us about the property and we will tell you whether it matches what our developer and investor clients are actively buying — and what they are prepared to pay. No listing, no commission, no showings.';
---

<Base title={title} description={description}>
  <header class="hero hero-short">
    <Backdrop src="https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=2400&q=80" variant="hero" priority />
    <div class="hero-content">
      <span class="eyebrow">Sell a property</span>
      <h1>Tell us about the <em>property.</em></h1>
      <p class="lead">
        Ninety seconds now, and we will tell you whether it fits what our buyers are looking for.
      </p>
    </div>
  </header>

  <section class="section" id="offer">
    <div class="section-inner">
      <div class="grid-2" style="gap: 5rem; align-items: start;">
        <div data-reveal>
          <SellerForm />
        </div>

        <aside data-reveal data-reveal-delay="2">
          <div class="callout">
            <h3>What happens next</h3>
            <p style="margin-bottom: 1.4rem;">
              We check the property against what our developer and investor clients are actively
              buying, then call you with a number and the reasoning behind it. If it works, you
              pick the closing date.
            </p>
            <p style="margin-bottom: 1.4rem;">
              <strong class="brass">No commission.</strong> No showings. No repairs. No listing,
              and no sign in the yard.
            </p>
            <p style="margin-bottom: 1.4rem;">
              There is more than one way to do this — a cash close, our
              <a href="/ways-to-sell#sold-before-built" style="color: var(--sage); font-weight: 600;"
                >Sold Before Built</a
              > program, or a traditional listing.
              <a href="/ways-to-sell" style="color: var(--sage); font-weight: 600;">Compare all four</a>.
            </p>
            <p>
              Prefer to talk? Call or text
              <a href={`tel:${site.phone}`} style="color: var(--sage); font-weight: 600;"
                >{site.phoneDisplay}</a
              >.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <script src="../scripts/lead-form.ts"></script>
</Base>
