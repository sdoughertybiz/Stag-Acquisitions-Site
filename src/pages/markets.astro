---
import Base from '../layouts/Base.astro';
import Backdrop from '../components/Backdrop.astro';
import { markets } from '../data/site';

const title = 'Markets — Where Stag Acquisitions Buys';
const description =
  'We buy homes in Nashville, Tennessee; Scottsdale, Arizona; Charlotte, North Carolina; and across the United States. Off-market, cash, any condition.';

const criteria = [
  {
    letter: 'A',
    title: 'Situation',
    body: 'A seller motivated by time, condition, or a life event. Speed and certainty have to be worth something to you.',
  },
  {
    letter: 'B',
    title: 'Numbers',
    body: 'A price that leaves room for the work the property needs. We are not chasing trophy deals.',
  },
  {
    letter: 'C',
    title: 'Title',
    body: 'Clean or cleanable. Liens, back taxes, and probate are all workable — we just need to know up front.',
  },
];
---

<Base title={title} description={description}>
  <header class="hero hero-short">
    <Backdrop
      src="https://images.unsplash.com/photo-1568605114967-8130f3a36994?auto=format&fit=crop&w=2400&q=80"
      variant="hero"
      priority
    />
    <div class="hero-content">
      <span class="eyebrow">Where we buy</span>
      <h1>Three home markets.<br /><em>One country.</em></h1>
      <p class="lead">
        Nashville, Scottsdale, and Charlotte are where we know the comps block by block. We buy
        everywhere else too.
      </p>
      <div class="hero-cta">
        <a class="cta" href="/offer">
          Submit your address
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </header>

  <section class="section" id="primary-markets">
    <div class="section-inner">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Our markets</span>
        <h2>The markets we live in.</h2>
        <p class="lead">
          In these three we can put a number in front of you the same day you call.
        </p>
      </div>

      <div class="grid-2">
        {markets.map((market, index) => (
          <div class="market-card" data-reveal data-reveal-delay={String((index % 4) + 1)}>
            <div>
              <span class="market-label">{market.label}</span>
              <h3>{market.name}</h3>
            </div>
            <p>{market.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section ambient" id="criteria">
    <Backdrop
      src="https://images.unsplash.com/photo-1449844908441-8829872d2607?auto=format&fit=crop&w=2000&q=80"
      variant="ambient"
    />
    <div class="section-inner">
      <div class="section-head" data-reveal>
        <span class="eyebrow">The fit test</span>
        <h2>What makes a property work for us.</h2>
        <p class="lead">
          Three things decide whether we can move quickly.
        </p>
      </div>

      <div class="grid-3">
        {criteria.map((item, index) => (
          <div class="feature" data-reveal data-reveal-delay={String(index + 1)}>
            <span class="feature-num">{item.letter}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="final-cta">
    <div class="section-inner center" style="max-width: 720px;">
      <div data-reveal>
        <span class="eyebrow">Outside our markets?</span>
        <h2 style="margin: 1.5rem 0 2rem;">Send the address anyway.</h2>
        <p class="lead" style="max-width: 50ch; margin: 0 auto 3rem;">
          Worst case we tell you it is not a fit. That costs you two minutes.
        </p>
        <a class="cta" href="/offer">
          Get a cash offer
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</Base>
