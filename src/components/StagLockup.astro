---
/**
 * The Stag Acquisitions lockup, from the supplied brand artwork.
 *
 * Paths are the original outlines simplified with Ramer-Douglas-Peucker at a
 * 1.2-unit tolerance — the source files were 1px raster traces of ~17,000
 * vertices and 140KB each. At every size the site renders, the simplified
 * artwork differs from the original by well under 2% of its edge pixels.
 * Regenerate rather than hand-editing: scratchpad/logo/build_components.py.
 *
 * Everything is `currentColor`, so the lockup takes the colour of whatever it
 * sits in. The mark and the lettering carry separate classes so they can be
 * given different colours — see `.nav-brand` and `.footer-wordmark`.
 */
interface Props {
  variant?: 'compact' | 'horizontal' | 'stacked';
  /** Rendered height in px. Width follows from the artwork's aspect ratio. */
  height?: number;
  class?: string;
  /** Decorative when the surrounding link already names the brand. */
  decorative?: boolean;
}

const {
  variant = 'horizontal',
  height,
  class: className = '',
  decorative = false,
} = Astro.props;

const VIEW_BOXES = {
  compact: '63.4117 63.1842 1166.69 293.631',
  horizontal: '105.412 105.184 1573.56 293.631',
  stacked: '100.213 103.609 568.879 502.684',
} as const;
const viewBox = VIEW_BOXES[variant];

// Emit real width/height attributes rather than leaving the SVG to infer a
// size. Without them the element has no intrinsic width inside the nav's flex
// row and the artwork spills out of the bar.
const [, , boxW, boxH] = viewBox.split(' ').map(Number);
const h = height ?? (variant === 'stacked' ? 64 : 38);
const w = Math.round(((h * boxW!) / boxH!) * 100) / 100;

const label = decorative ? undefined : 'Stag Acquisitions';
---

<svg
  class={`stag-lockup stag-lockup-${variant} ${className}`.trim()}
  viewBox={viewBox}
  width={w}
  height={h}
  role={decorative ? 'presentation' : 'img'}
  aria-label={label}
  aria-hidden={decorative ? 'true' : undefined}
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
