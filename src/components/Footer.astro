---
import { DISCLOSURE_FOOTER, marketSummary, nav, site } from '../data/site';
import StagLockup from './StagLockup.astro';

const year = 2026;
---

<footer class="footer">
  <div class="footer-inner">
    <div>
      <StagLockup height={44} class="footer-wordmark" />
      <div class="footer-tag">{site.tagline}</div>
    </div>

    <div class="footer-col">
      <h5>Site</h5>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>

    <div class="footer-col">
      <h5>Contact</h5>
      <a href={`tel:${site.phone}`}>Call or text {site.phoneDisplay}</a>
      {marketSummary.map((line) => <p>{line}</p>)}
    </div>

    <div class="footer-col">
      <h5>Legal</h5>
      <a href="/disclosures">Disclosures</a>
      <a href="/privacy">Privacy Policy</a>
      <a href="/privacy#sms-messaging">SMS Terms</a>
      <p>Reply STOP to opt out of SMS.</p>
    </div>
  </div>

  <!-- Sitewide, so a seller cannot reach a form without having passed it. -->
  <div class="footer-disclosure">
    <p>
      {DISCLOSURE_FOOTER} <a href="/disclosures">Read the full disclosures</a>.
    </p>
  </div>

  <div class="footer-bottom">
    <span>&copy; {year} {site.legalEntity} &middot; United States</span>
    <span>Specialized acquisitions &middot; Not a licensed real estate brokerage</span>
  </div>
</footer>
