---
/**
 * The Stag mark: a solid stylized head with stroked antlers above it.
 *
 * The head is filled rather than stroked on purpose — at 30px in the nav a
 * purely linear mark dissolves into a squiggle, and the solid mass is what
 * makes it legible as an animal at small sizes.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className = '' } = Astro.props;
---

<svg
  class={`stag-mark ${className}`}
  width={size}
  height={size * 0.8}
  viewBox="0 0 64 50"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <g stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
    <!-- Left antler -->
    <path d="M27.5 34 C 23 28.5 17 22.5 8.5 13.5" />
    <path d="M23.6 29 C 19 27.2 15 26.6 9.5 26.6" />
    <path d="M19 23 C 17 19.5 15.8 16.5 14.5 12.5" />

    <!-- Right antler -->
    <path d="M36.5 34 C 41 28.5 47 22.5 55.5 13.5" />
    <path d="M40.4 29 C 45 27.2 49 26.6 54.5 26.6" />
    <path d="M45 23 C 47 19.5 48.2 16.5 49.5 12.5" />
  </g>

  <!-- Head -->
  <path
    fill="currentColor"
    d="M32 48.5 C 28.2 44.4 26.4 40.2 26.4 35.6 C 26.4 33.2 28.6 31.9 32 31.9 C 35.4 31.9 37.6 33.2 37.6 35.6 C 37.6 40.2 35.8 44.4 32 48.5 Z"
  />
</svg>
