---
/**
 * The STAG / ACQUISITIONS lockup — mark plus stacked name.
 *
 * Shared by the nav and the footer so the two can't drift apart. The type is
 * set explicitly here rather than inherited, which is what let them diverge
 * in the first place.
 */
import StagMark from './StagMark.astro';
import { site } from '../data/site';

interface Props {
  /** Pixel size of the stag mark; the type scales alongside it. */
  markSize?: number;
  size?: 'sm' | 'lg';
  class?: string;
}

const { markSize = 30, size = 'sm', class: className = '' } = Astro.props;
---

<span class:list={['wordmark', `wordmark-${size}`, className]}>
  <StagMark size={markSize} />
  <span class="wordmark-text">
    <strong>{site.shortName}</strong>
    <span>{site.wordmarkSuffix}</span>
  </span>
</span>
