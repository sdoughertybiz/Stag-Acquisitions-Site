{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stag-acquisitions-site",
  // No account_id on purpose. It used to be hardcoded, which silently pointed
  // deploys at a different Cloudflare account and failed. Wrangler resolves the
  // account from `wrangler login`, or from CLOUDFLARE_ACCOUNT_ID in CI.
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve dist/404.html for any path that does not resolve. Without this a
    // mistyped postcard URL gets a bare Cloudflare error page.
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Non-secret config. Secrets (FUB_API_KEY, FUB_SYSTEM_KEY) are set with:
    //   npx wrangler secret put FUB_API_KEY
    "FUB_SOURCE": "StagAcquisitions.com",
    "FUB_SYSTEM": "StagAcqSite",
    "FUB_ASSIGNED_TO": "Stephen Dougherty",
    "FUB_ASSIGNED_USER_ID": "1"
  }
}
